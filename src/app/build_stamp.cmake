# Writes the build time for the window title, and the commit and the rexbox
# version and commit for the settings menu's Info tab. Runs on every build, so
# a moved rexbox submodule shows without a reconfigure; the file changes (and
# the app recompiles main.cpp and relinks) only when one of the values does.
string(TIMESTAMP REJSRF_BUILD_TIME "%Y-%m-%d %H:%M")

# The short commit of the checkout at `dir`, with "+modified" when tracked
# files changed since it; "unknown" when git cannot tell.
function(rejsrf_git_commit dir out)
    set(value "unknown")
    execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY "${dir}"
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
    if(result EQUAL 0 AND NOT commit STREQUAL "")
        set(value "${commit}")
        execute_process(COMMAND git status --porcelain --untracked-files=no WORKING_DIRECTORY "${dir}"
                        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT changes STREQUAL "")
            set(value "${commit}+modified")
        endif()
    endif()
    set(${out} "${value}" PARENT_SCOPE)
endfunction()

set(REJSRF_GIT_COMMIT "unknown")
set(REJSRF_REXBOX_VERSION "unknown")
set(REJSRF_REXBOX_COMMIT "unknown")
if(DEFINED SOURCE_DIR)
    rejsrf_git_commit("${SOURCE_DIR}" REJSRF_GIT_COMMIT)
    # The shared runtime, third_party/rexbox (issue #111).
    set(rexbox_dir "${SOURCE_DIR}/third_party/rexbox")
    if(EXISTS "${rexbox_dir}/VERSION")
        file(STRINGS "${rexbox_dir}/VERSION" REJSRF_REXBOX_VERSION LIMIT_COUNT 1)
        string(STRIP "${REJSRF_REXBOX_VERSION}" REJSRF_REXBOX_VERSION)
        rejsrf_git_commit("${rexbox_dir}" REJSRF_REXBOX_COMMIT)
    endif()
endif()
string(CONCAT content
    "// Generated by src/app/build_stamp.cmake.\n"
    "#define REJSRF_BUILD_TIME \"${REJSRF_BUILD_TIME}\"\n"
    "#define REJSRF_GIT_COMMIT \"${REJSRF_GIT_COMMIT}\"\n"
    "#define REJSRF_REXBOX_VERSION \"${REJSRF_REXBOX_VERSION}\"\n"
    "#define REJSRF_REXBOX_COMMIT \"${REJSRF_REXBOX_COMMIT}\"\n")
set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
