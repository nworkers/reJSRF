# Writes the build time for the window title. Runs on every build; the file
# changes (and the app recompiles main.cpp and relinks) only when the minute
# does.
string(TIMESTAMP REJSRF_BUILD_TIME "%Y-%m-%d %H:%M")
set(content "// Generated by src/app/build_stamp.cmake.\n#define REJSRF_BUILD_TIME \"${REJSRF_BUILD_TIME}\"\n")
set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
