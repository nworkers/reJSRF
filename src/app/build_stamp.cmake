# Writes the build time for the window title and the commit for the settings
# menu's Info tab. Runs on every build; the file changes (and the app
# recompiles main.cpp and relinks) only when the minute or the commit does.
string(TIMESTAMP REJSRF_BUILD_TIME "%Y-%m-%d %H:%M")
set(REJSRF_GIT_COMMIT "unknown")
if(DEFINED SOURCE_DIR)
    execute_process(COMMAND git rev-parse --short HEAD WORKING_DIRECTORY "${SOURCE_DIR}"
                    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE result)
    if(result EQUAL 0 AND NOT commit STREQUAL "")
        set(REJSRF_GIT_COMMIT "${commit}")
        # Tracked files changed since that commit.
        execute_process(COMMAND git status --porcelain --untracked-files=no WORKING_DIRECTORY "${SOURCE_DIR}"
                        OUTPUT_VARIABLE changes OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(NOT changes STREQUAL "")
            set(REJSRF_GIT_COMMIT "${commit}+modified")
        endif()
    endif()
endif()
set(content "// Generated by src/app/build_stamp.cmake.\n#define REJSRF_BUILD_TIME \"${REJSRF_BUILD_TIME}\"\n#define REJSRF_GIT_COMMIT \"${REJSRF_GIT_COMMIT}\"\n")
set(previous "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" previous)
endif()
if(NOT previous STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()
