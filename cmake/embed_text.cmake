# Makes a C++ header that holds a text file's bytes, for third-party shader
# sources such as SMAA.hlsl. Bytes, not a string literal, so the file's
# encoding does not matter to the compiler and no literal-length limit applies.
#
#   embed_text(INPUT <file> OUTPUT <header> NAME <identifier>)
#
# The header defines `inline const unsigned char <NAME>[]` (the bytes followed
# by a zero) and `inline constexpr unsigned <NAME>Size` (without the zero).
function(embed_text)
    cmake_parse_arguments(ARG "" "INPUT;OUTPUT;NAME" "" ${ARGN})
    file(READ "${ARG_INPUT}" hex HEX)
    string(LENGTH "${hex}" hex_length)
    math(EXPR size "${hex_length} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # About 16 bytes a line.
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){16})" "\\1\n    " bytes "${bytes}")
    get_filename_component(source_name "${ARG_INPUT}" NAME)
    set(content "// Generated by cmake/embed_text.cmake from ${source_name}; do not edit.\n#pragma once\ninline constexpr unsigned ${ARG_NAME}Size = ${size};\ninline const unsigned char ${ARG_NAME}[] = {\n    ${bytes}0x00,\n};\n")
    set(previous "")
    if(EXISTS "${ARG_OUTPUT}")
        file(READ "${ARG_OUTPUT}" previous)
    endif()
    if(NOT previous STREQUAL content)
        file(WRITE "${ARG_OUTPUT}" "${content}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ARG_INPUT}")
endfunction()
